# Copy to web/.env for running the scripts locally. web/.env is gitignored.
# Supabase -> your project -> Connect -> "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres
# Any long random string; Vercel Cron sends it to /api/cron. Same value goes in Vercel's env vars.
CRON_SECRET=
# Password for signing in to the dashboard (same value goes in Vercel's env vars).
DASHBOARD_PASSWORD=
