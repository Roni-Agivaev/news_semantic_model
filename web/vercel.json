{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/politics", "destination": "/" }
  ],
  "functions": {
    "api/cron.py": { "maxDuration": 300 },
    "api/stats.py": { "maxDuration": 30 },
    "api/articles.py": { "maxDuration": 30 },
    "api/logs.py": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron?topic=defense", "schedule": "0 20 * * *" },
    { "path": "/api/cron?topic=politics", "schedule": "30 20 * * *" }
  ]
}
